#!/usr/bin/env python3
"""Generate complete notices from Cargo.lock and downloaded crate sources.
Run cargo fetch --locked first (all target platforms). No network calls here.
"""
import argparse
import json
import re
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]

def posix_order(path):
    """Case-sensitive POSIX path order on every host (Windows paths compare case-folded)."""
    return path.as_posix().split('/')

def generate():
    metadata = json.loads(subprocess.check_output(
        ['cargo', 'metadata', '--locked', '--format-version', '1'], cwd=ROOT))
    # Resolve production features without dev edges. Filtering metadata's graph
    # alone still retains optional runtime edges activated only by test features.
    tree = subprocess.check_output([
        'cargo', 'tree', '--locked', '--workspace', '--edges', 'normal,build',
        '--target', 'all', '--prefix', 'none', '--format', '{p}',
    ], cwd=ROOT, text=True)
    shipped = {(parts[0], parts[1].removeprefix('v'))
               for line in tree.splitlines() if len(parts := line.split()) >= 2}
    supplements = json.loads((ROOT / 'dist/licenses/crates/sources.json').read_text(encoding='utf-8'))
    sections = ['Third-party notices for vork\n\nGenerated by scripts/generate-notice.\n'
                'Bundled tools keep their complete upstream notices in slang/ and oidn/.\n'
                'Windows packages ship Microsoft Visual C++ runtime DLLs in oidn/bin; see licenses/msvc-runtime.txt.\n'
                'Includes the locked dependency graph for all platforms, including build dependencies.\n'
                'Dependency licences apply independently of the project licence.\n']
    # Path-patched third-party crates still need attribution; only our own
    # workspace crates are omitted from the third-party dependency sections.
    packages = sorted((p for p in metadata['packages']
                       if (p['name'], p['version']) in shipped and (p['source'] or Path(p['manifest_path']).is_relative_to(ROOT / 'vendor'))),
                      key=lambda p: (p['name'], p['version']))
    for p in packages:
        root = Path(p['manifest_path']).parent
        files = sorted((f for f in root.rglob('*') if f.is_file() and
                        f.name.lower().startswith(('license', 'licence', 'copying', 'copyright'))), key=posix_order)
        extra = ROOT / 'dist/licenses/crates' / p['name']
        if extra.exists():
            if supplements[p['name']]['version'] != p['version']:
                raise SystemExit(f"Review supplemental licence after dependency update: {p['name']} {p['version']}")
            files += sorted(extra.glob('*'), key=posix_order)
        if not files:
            raise SystemExit(f"Missing licence text: {p['name']} {p['version']}")
        sections.append(f"\n{'=' * 72}\n{p['name']} {p['version']}\n"
                        f"SPDX: {p['license']}\nSource: {p.get('repository') or p['source']}\n")
        seen = set()
        for f in files:
            text = f.read_text(encoding='utf-8', errors='strict')
            if text not in seen:
                sections.append(f'\n--- {f.name} ---\n{text}\n')
                seen.add(text)
        # Preserve embedded notices too: native vendored code may have no
        # standalone licence (including notices at the bottom of a source file).
        for f in sorted(root.rglob('*'), key=posix_order):
            if not f.is_file() or f.suffix not in ('.c', '.cpp', '.h', '.hpp', '.hh', '.inl', '.ispc', '.m', '.mm'):
                continue
            text = f.read_text(encoding='utf-8', errors='replace')
            comments = re.findall(r'/\*[\s\S]*?\*/|(?m:^[ \t]*//[^\n]*(?:\n[ \t]*//[^\n]*)*)', text)
            for comment in comments:
                if re.search(r'copyright|licen[sc]e|redistribution|permission is hereby|public domain|unlicense', comment, re.I) and comment not in seen:
                    sections.append(f'\n--- Native source / {f.relative_to(root).as_posix()} ---\n{comment}\n')
                    seen.add(comment)
    for f in sorted((ROOT / 'dist/licenses').glob('*.txt'), key=posix_order):
        sections.append(f'\n--- {f.name} ---\n{f.read_text(encoding="utf-8")}\n')
    for f in sorted((ROOT / 'crates/vork-render/src/ltc').glob('LICENSE*'), key=posix_order):
        sections.append(f'\n--- LTC / {f.name} ---\n{f.read_text(encoding="utf-8")}\n')
    for f in sorted((ROOT / 'crates/vork-render/shaders/third_party').glob('*/LICENSE'), key=posix_order):
        sections.append(f'\n--- Vendored shader / {f.parent.name} ---\n{f.read_text(encoding="utf-8")}\n')
    for f in sorted((ROOT / 'libraries/std/third_party').glob('*LICENSE*'), key=posix_order):
        sections.append(f'\n--- Standard library / {f.name} ---\n{f.read_text(encoding="utf-8")}\n')
    header = (ROOT / 'crates/vork-encode/native/nvcodec/nvEncodeAPI.h').read_text(encoding='utf-8')
    sections.append('\n--- NVIDIA NVENC headers ---\n' + header.split('*/', 1)[0] + '*/\n')
    sections.append('\n--- OCIO display attribution ---\nBlender AgX and Filmic baked display transforms.\n'
                    'Original AgX: Troy Sobotka. Further development: Zijun Eary Zhou, '
                    'Mark Faderbauer and Sakari Kapanen.\n'
                    'https://github.com/EaryChow/AgX\n'
                    'OCIO licence source: Blender commit 3237ae2855b6dbfad8ba9e86e6e7add0942403d7, '
                    'release/text/ocio-license.txt.\n')
    for f in sorted((ROOT / 'examples/assets').iterdir(), key=posix_order):
        if f.suffix in ('.txt', '.md'):
            sections.append(f'\n--- Assets / {f.name} ---\n{f.read_text(encoding="utf-8")}\n')
    for f in sorted((ROOT / 'dist/licenses/assets').glob('*.md'), key=posix_order):
        sections.append(f'\n--- Benchmark assets / {f.name} ---\n{f.read_text(encoding="utf-8")}\n')
    return '\n'.join(line.rstrip() for line in ''.join(sections).splitlines()).rstrip() + '\n'

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    result = generate()
    output = ROOT / 'NOTICE'
    if args.check:
        if not output.exists() or output.read_text(encoding='utf-8') != result:
            raise SystemExit('NOTICE is stale; run scripts/generate-notice')
    else:
        output.write_text(result, encoding='utf-8', newline='\n')
    print(f'NOTICE: {len(result.encode())} bytes')
