#!/usr/bin/env python3
"""Check installed project packages without a global vork. Run inside a fresh
npm project and venv after installing from the private registry/index.
Rendering and setup require a supported real GPU; --gpu enables them.
"""
import argparse
import json
import ctypes
import os
import shutil
from pathlib import Path
import subprocess
import sys

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--gpu', action='store_true')
p.add_argument('--starter-render', action='store_true',
               help='render the installed starter through both CLIs; VORK_GPU=cpu is supported')
a = p.parse_args()

def run(args):
    print('+', *args, flush=True)
    args[0] = shutil.which(args[0]) or args[0]
    subprocess.run(args, check=True)

# pip supplies only the SDK; use the renderer installed by npm on PATH.
os.environ['PATH'] = str(Path('node_modules/.bin').resolve()) + os.pathsep + os.environ['PATH']
run(['npx', '--no-install', 'vork', '--version'])
run([sys.executable, '-c', 'from vork._engine import engine; import subprocess; subprocess.run([engine(), "--version"], check=True)'])
run(['node', '--input-type=module', '-e', 'import {extrude} from "@voyager-so/vork"; console.log(Object.keys(extrude("shape", {outline:[[0,0],[1,0],[0,1]]})));'])
run([sys.executable, '-c', 'from vork import std; print(list(std("rounded_box", name="ball")))'])
# Check the installed npm runtime and the SDK-only pip metadata.
target = {'linux': 'linux-x64', 'darwin': 'darwin-arm64', 'win32': 'windows-x64'}[sys.platform]
npm_runtime = Path('node_modules/@voyager-so') / ('vork-' + target) / 'runtime'
runtime = npm_runtime.resolve()
from importlib.metadata import distribution
assert not distribution('vork').requires
assert not distribution('vork').entry_points
companion = 'vork-slang-filesystem.exe' if os.name == 'nt' else 'vork-slang-filesystem'
adapter = npm_runtime / companion
assert adapter.is_file(), f'missing installed Slang filesystem adapter: {adapter}'
assert os.access(adapter, os.X_OK), f'adapter is not executable: {adapter}'

if a.starter_render:
    # No development toolchain or engine override may hide a broken package.
    for key in ('VORK_BIN', 'VORK_SLANGC', 'VORK_SLANG_FILESYSTEM', 'VORK_OIDN'):
        os.environ.pop(key, None)
    for name, command in [('npm', ['npx', '--no-install', 'vork']),
                          ('pip', [shutil.which('vork')])]:
        starter = Path(name + '-starter')
        run(command + ['init', str(starter), '--language', 'json'])
        # Fresh per-install receipts force the installed companion to execute.
        os.environ['VORK_CACHE_DIR'] = str((starter / 'cache').resolve())
        frame = starter / 'frame.png'
        run(command + ['render', str(starter / 'scene.json'), '--profile', 'std/draft',
                       '--set', 'resolution=[128,96]', '--out', str(frame)])
        assert frame.read_bytes().startswith(b'\x89PNG\r\n\x1a\n'), frame

run([str(runtime / 'slang/bin' / ('slangc.exe' if os.name == 'nt' else 'slangc')), '-version'])
oidn = runtime / 'oidn' / ('bin/OpenImageDenoise.dll' if os.name == 'nt' else ('lib/libOpenImageDenoise.2.dylib' if sys.platform == 'darwin' else 'lib/libOpenImageDenoise.so.2'))
ctypes.CDLL(str(oidn))
print('Installed OIDN runtime loads:', oidn, flush=True)

if a.gpu:
    scene = {'version': 2, 'nodes': [
        {'type': 'mesh', 'geometry': 'ball', 'name': 'ball'},
        {'type': 'light', 'shape': 'point', 'translation': [2, 3, 4], 'energy': 100},
        {'type': 'camera', 'translation': [0, 0, 4], 'target': [0, 0, 0]}],
        'render': {'resolution': [128, 128]}}
    from vork import std
    scene.update(std('rounded_box', name='ball'))
    Path('smoke.json').write_text(json.dumps(scene))
    for i, command in enumerate([['npx', '--no-install', 'vork'], [shutil.which('vork')]]):
        run(command + ['setup'])
        run(command + ['render', 'smoke.json', '--out', ('npm.png' if i == 0 else 'pip.png')])
    run(['node', '--input-type=module', '-e', 'import {render} from "@voyager-so/vork"; render("smoke.json", {out:"ts-api.png"});'])
    run([sys.executable, '-c', 'from vork import render; render("smoke.json", "python-api.png")'])
    run(['npx', '--no-install', 'vork', 'render', 'smoke.json', '--frame-start', '0', '--frame-end', '2', '--out', 'smoke.mp4'])
    scene['programs'] = {'paint': {'source': 'import vork; struct Inputs {}; Closure surface(ShadingContext ctx, Inputs inputs) { Closure c = {}; c.base_color = float3(0.8, 0.15, 0.05); c.specular_roughness = 0.4; return c; }'}}
    scene['materials'] = {'paint': {'program': 'paint'}}
    scene['nodes'][0]['materials'] = ['paint']
    Path('custom.json').write_text(json.dumps(scene))
    run(['npx', '--no-install', 'vork', 'render', 'custom.json', '--out', 'custom.png'])
