    "checker": {
      "source": "import vork;\nimport blender.procedurals;\nstruct Inputs { float3 a = float3(0.08); float3 b = float3(0.6); float size = 1.0; };\nClosure surface(ShadingContext ctx, Inputs inputs) {\n    Closure c = {};\n    c.base_color = lerp(inputs.a,inputs.b,(1.-float((int(floor(float3(ctx.POSITION.x, 0, ctx.POSITION.z).x*1.0 / inputs.size))^int(floor(float3(ctx.POSITION.x, 0, ctx.POSITION.z).y*1.0 / inputs.size))^int(floor(float3(ctx.POSITION.x, 0, ctx.POSITION.z).z*1.0 / inputs.size)))&1)));\n    c.specular_roughness = 0.6;\n    return c;\n}\n"
    }
