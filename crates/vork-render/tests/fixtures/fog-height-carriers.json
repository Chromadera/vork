    "fog": {
      "source": "// Marine layer for stage 1 world fog: certified exponential-height form.\n// Extinction = coefficient * exp(-falloff * (y - base_height)); dense below base_height, thinning quickly above it.\n// Zero channels stay zero where the exponential would overflow.\nimport vork;\nstruct Inputs {\n    float3 scattering = float3(0.12);\n    float3 absorption = float3(0.0);\n    float base_height = 72.0;\n    float falloff = 0.09;\n    float anisotropy = 0.55;\n};\nfloat sc1(float c, float s) { return c == 0.0 ? 0.0 : c * s; }\nfloat3 sc3(float3 c, float s) { return float3(sc1(c.x, s), sc1(c.y, s), sc1(c.z, s)); }\nMediumCoefficients medium(MediumContext ctx, Inputs i) {\n    float s = exp(-i.falloff * (ctx.world_position.y - i.base_height));\n    MediumCoefficients m;\n    m.scattering = sc3(i.scattering, s);\n    m.absorption = sc3(i.absorption, s);\n    m.emission = float3(0.0);\n    m.anisotropy = i.anisotropy;\n    return m;\n}\n"
    },
    "haze": {
      "source": "// Homogeneous coastal haze inside one large closed convex box carrier (aerial perspective on the hills and city).\nimport vork;\nstruct Inputs {\n    float3 scattering = float3(0.00012);\n    float3 absorption = float3(0.0);\n    float anisotropy = 0.5;\n};\nMediumCoefficients medium(MediumContext ctx, Inputs i) {\n    MediumCoefficients m;\n    m.scattering = i.scattering;\n    m.absorption = i.absorption;\n    m.emission = float3(0.0);\n    m.anisotropy = i.anisotropy;\n    return m;\n}\n"
    },
    "bank": {
      "source": "// Homogeneous coastal haze inside one large closed convex box carrier (aerial perspective on the hills and city).\nimport vork;\nstruct Inputs {\n    float3 scattering = float3(0.00012);\n    float3 absorption = float3(0.0);\n    float anisotropy = 0.5;\n};\nMediumCoefficients medium(MediumContext ctx, Inputs i) {\n    MediumCoefficients m;\n    m.scattering = i.scattering;\n    m.absorption = i.absorption;\n    m.emission = float3(0.0);\n    m.anisotropy = i.anisotropy;\n    return m;\n}\n"
    }
