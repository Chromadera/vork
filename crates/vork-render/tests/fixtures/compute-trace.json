    "invisible": {
      "source": "import vork; struct Inputs {}; Closure surface(ShadingContext ctx,Inputs i) {Closure c={};c.geometry_opacity=0.;return c;}"
    },
    "show": {
      "source": "import vork;struct Inputs {};Closure surface(ShadingContext ctx,Inputs i){return unlit(ctx.COLOR_0.rgb);}"
    },
    "bake": {
      "source": "struct Inputs {}; void compute(ComputeContext ctx,Inputs i) {\n    bool good=true;\n#if 1\n    let o=float3(2.,2.,0.);let d=float3(0.,-2.,0.);\n    let h=trace(o,d,0.,3.,255u,1u);\n    good=h.hit && abs(h.distance-2.05)<.0001 && length(h.position-float3(2.,-.05,0.))<.0001;\n    good=good && length(h.geometric_normal-float3(0.,1.,0.))<.0001 && length(h.shading_normal-float3(0.,1.,0.))<.0001;\n    good=good && h.object_id==1u && h.instance_index==0u && h.primitive_id==4u && h.front_facing;\n    good=good && length(h.barycentrics-float3(1./6.,1./3.,.5))<.0001 && length(h.uv-float2(5./6.,.5))<.0001;\n    let back=trace(o,d,2.1,3.,255u,1u);\n    good=good && back.hit && abs(back.distance-2.25)<.0001 && !back.front_facing && back.primitive_id==6u && back.object_id==h.object_id;\n    good=good && length(back.geometric_normal-float3(0.,-1.,0.))<.0001;\n    let miss=trace(o,d,0.,1.,255u,1u);\n    good=good && !miss.hit && miss.distance==-1. && miss.object_id==0xffffffffu && miss.instance_index==0xffffffffu && miss.primitive_id==0xffffffffu;\n    good=good && all(miss.position==float3(0.)) && all(miss.geometric_normal==float3(0.)) && all(miss.shading_normal==float3(0.)) && all(miss.barycentrics==float3(0.)) && all(miss.uv==float2(0.)) && !miss.front_facing;\n    good=good && !trace(o,d,0.,3.,0u).hit && !trace(o,d,0.,3.,255u,0xfffffffeu).hit;\n    let selected=trace(o,d,0.,3.,255u,1u);\n    good=good && selected.hit && selected.object_id==h.object_id && selected.primitive_id==h.primitive_id;\n    good=good && !trace(o,float3(0.),0.,3.,255u,1u).hit && !trace(o,d,-1.,3.,255u,1u).hit && !trace(o,d,3.,1.,255u,1u).hit;\n#endif\ncolor_store(ctx.id.x,good ? float3(0.,1.,0.) : float3(1.,0.,0.));\n}",
      "schedule": "frame",
      "dispatch": 4,
      "bindings": {
        "color": "screen_color"
      }
