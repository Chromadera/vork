// Exposure report: alpha-weighted clipped/near-black counts, luma sum, coverage
// and processed-pixel count of the final display image, each a 64-bit counter of
// two 32-bit words (portable atomics). The
// including shader imports vork_constants, declares `counters` and reads its display image.

groupshared uint group_counts[5];

void add_wide(uint word, uint value) {
    uint previous;
    InterlockedAdd(counters[word], value, previous);
    if (previous > 0xffffffffu - value) InterlockedAdd(counters[word + 1u], 1u);
}
void begin(uint lane) {
    if (lane < 5u) group_counts[lane] = 0u;
    GroupMemoryBarrierWithGroupSync();
}
void count(float4 rgba) {
    InterlockedAdd(group_counts[4], 1u);
    float3 c = rgba.rgb;
    // RGBA8 coverage: even 64 * 255 * 65535 fits a group-local uint.
    uint weight = uint(round(saturate(rgba.a) * 255.));
    InterlockedAdd(group_counts[3], weight);
    // Rec.709 luma of the display-encoded values.
    float luma = dot(c, float3(0.2126, 0.7152, 0.0722));
    if (max(c.r, max(c.g, c.b)) >= REG_EXPOSURE_CLIPPED) InterlockedAdd(group_counts[0], weight);
    if (luma < REG_EXPOSURE_NEAR_BLACK) InterlockedAdd(group_counts[1], weight);
    InterlockedAdd(group_counts[2], uint(round(saturate(luma) * REG_EXPOSURE_LUMA_SCALE)) * weight);
}
void end(uint lane) {
    GroupMemoryBarrierWithGroupSync();
    if (lane < 5u && group_counts[lane] != 0u) add_wide(2u * lane, group_counts[lane]);
}
